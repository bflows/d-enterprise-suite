generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String

  firstName   String
  lastName    String
  phoneNumber String
  profileImg  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshSessions RefreshSession[]
  employees       Employee[]
}

model RefreshSession {
  id               String @id @default(cuid())
  userId           String
  refreshTokenHash String

  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  userAgent String?
  ip        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Company {
  id       String @id @default(cuid())
  name     String
  industry String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles       Role[]
  employees   Employee[]
  customers   Customer[]
  serviceBook ServiceBook[]
}

model Role {
  id        String @id @default(cuid())
  name      String
  slug      String // permission names: employee, technician, dispatcher, admin
  companyId String

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@unique([companyId, slug])
}

model Employee {
  id        String @id @default(cuid())
  userId    String
  companyId String
  roleSlug  String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [companyId, roleSlug], references: [companyId, slug], onDelete: Cascade)

  @@index([userId, companyId])
  @@index([companyId])
}

model Customer {
  id          String  @id @default(cuid())
  companyId   String
  firstName   String
  lastName    String
  email       String?
  phone       String
  leadSource  String?
  address     String
  address2    String?
  companyName String?
  notes       String?

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

model ServiceBook {
  id        String  @id @default(uuid())
  companyId String
  name      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company               @relation(fields: [companyId], references: [id])
  catories ServiceBookCategory[]

  @@index([companyId])
}

model ServiceBookCategory {
  id            String @id @default(uuid())
  serviceBookId String
  name          String

  sortOrder Int?     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceBook ServiceBook   @relation(fields: [serviceBookId], references: [id], onDelete: Cascade)
  items       ServiceItem[]

  @@index([serviceBookId])
}

enum ServiceItemType {
  SERVICE
  ADDON
}

model ServiceItem {
  id         String          @id @default(uuid())
  categoryId String
  type       ServiceItemType

  title       String
  description String
  price       Int
  duration    Int
  unit        Int

  sortOrder Int? @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category ServiceBookCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
}
