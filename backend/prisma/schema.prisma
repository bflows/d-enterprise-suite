generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String

  firstName   String
  lastName    String
  phoneNumber String
  profileImg  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshSessions RefreshSession[]
  employees       Employee[]
  timeCards       TimeCard[]
  jobPhotos       JobPhoto[]
  jobActivities   JobActivity[]
}

model RefreshSession {
  id               String @id @default(cuid())
  userId           String
  refreshTokenHash String

  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  userAgent String?
  ip        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Company {
  id       String @id @default(cuid())
  name     String
  industry String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles         Role[]
  employees     Employee[]
  customers     Customer[]
  serviceBook   ServiceBook[]
  jobs          Job[]
  timeCards     TimeCard[]
  jobPhotos     JobPhoto[]
  jobActivities JobActivity[]
  invoices      Invoice[]

  @@index([id])
}

model Role {
  id        String @id @default(cuid())
  name      String
  slug      String // permission names: employee, technician, dispatcher, admin
  companyId String

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@unique([companyId, slug])
}

model Employee {
  id        String @id @default(cuid())
  userId    String
  companyId String
  roleSlug  String

  user                     User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company                  Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role                     Role                     @relation(fields: [companyId, roleSlug], references: [companyId, slug], onDelete: Cascade)
  jobs                     Job[]
  technicianAvailabilities TechnicianAvailability[]

  @@index([userId, companyId])
  @@index([companyId])
}

/// Recurring weekly availability for a technician: one record = one day of week + time window.
/// Example: Employee has 3 records = Mon 9-5, Wed 9-12, Fri 9-5.
model TechnicianAvailability {
  id         String @id @default(cuid())
  employeeId String

  /// Day of week: 0 = Sunday, 1 = Monday, ... 6 = Saturday
  dayOfWeek        Int
  /// Start time in minutes from midnight (e.g. 540 = 09:00)
  startTimeMinutes Int
  /// End time in minutes from midnight (e.g. 1020 = 17:00)
  endTimeMinutes   Int

  /// Optional: rule only applies on or after this date
  effectiveFrom DateTime?
  /// Optional: rule only applies on or before this date
  effectiveTo   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model Customer {
  id          String  @id @default(cuid())
  companyId   String
  firstName   String
  lastName    String
  email       String?
  phone       String
  /// First-time SMS compliance notice (HELP/STOP); set with `smsComplianceNoticePhone`.
  smsComplianceNoticeSentAt   DateTime?
  smsComplianceNoticePhone    String?
  /// Stripe Customer id (cus_…); set when first invoice is created for this customer.
  stripeCustomerId String? @unique
  leadSource  String?
  address     String
  address2    String?
  city        String?
  zipCode     String?
  companyName String?
  notes       String?

  company Company @relation(fields: [companyId], references: [id])
  jobs    Job[]

  @@index([companyId])
}

model ServiceBook {
  id        String  @id @default(uuid())
  companyId String
  name      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company               @relation(fields: [companyId], references: [id])
  catories ServiceBookCategory[]

  @@index([companyId])
}

model ServiceBookCategory {
  id            String @id @default(uuid())
  serviceBookId String
  name          String

  sortOrder Int?     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceBook ServiceBook   @relation(fields: [serviceBookId], references: [id], onDelete: Cascade)
  items       ServiceItem[]

  @@index([serviceBookId])
}

enum ServiceItemType {
  SERVICE
  ADDON
}

model ServiceItem {
  id         String          @id @default(uuid())
  categoryId String
  type       ServiceItemType

  title       String
  description String
  /// Unit price in integer USD cents (Stripe `unit_amount` / invoice line amounts).
  price       Int
  duration    Int
  unit        Int?
  quantity    Int    @default(1)

  sortOrder Int?     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category ServiceBookCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  job      Job?                @relation(fields: [jobId], references: [id])
  jobId    String?

  @@index([categoryId])
}

enum JobStatusType {
  SCHEDULED
  EN_ROUTE
  ON_SITE
  COMPLETED
  CANCELLED
}

/// Billing / payment state for the job’s invoice (separate from field `Job.status`).
enum InvoiceStatusType {
  INVOICED
  PAID
  VOID
  UNCOLLECTABLE
  OVERDUE
  CANCELLED
}

model Job {
  id           String @id @default(uuid())
  companyId    String
  customerId   String
  technicianId String

  title      String?
  notes      String?
  leadSource String?
  status     JobStatusType

  /// Calendar date for the job (day-level).
  date      DateTime
  startTime DateTime
  /// Set by the API: start time plus total minutes from linked service items (duration × unit × quantity per item).
  endTime   DateTime

  /// Set when the 24-hour-before-start Twilio reminder SMS is sent (idempotency).
  reminder24hSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company       @relation(fields: [companyId], references: [id])
  customer   Customer      @relation(fields: [customerId], references: [id])
  technician Employee      @relation(fields: [technicianId], references: [id])
  services   ServiceItem[]
  photos     JobPhoto[]
  activities JobActivity[]
  invoice    Invoice?

  @@index([companyId])
  @@index([customerId])
  @@index([technicianId])
  @@index([date])
  @@index([status, reminder24hSentAt, startTime])
}

/// At most one invoice row per job; `stripeInvoiceId` is set when a Stripe invoice exists.
model Invoice {
  id              String            @id @default(cuid())
  companyId       String
  jobId           String            @unique
  stripeInvoiceId String?           @unique
  status          InvoiceStatusType @default(INVOICED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job     Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model JobActivity {
  id        String  @id @default(cuid())
  jobId     String
  companyId String
  type      JobActivityType @default(JOB_CREATED)
  logName   String
  userId    String?

  createdAt DateTime @default(now())

  job     Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@index([userId])
  @@index([createdAt])
}

enum JobActivityType {
  JOB_CREATED
  JOB_UPDATED
  JOB_STATUS_UPDATED
  JOB_NOTE_UPDATED
  JOB_ATTACHMENT_ADDED
  JOB_INVOICE_SENT
}

enum JobPhotoSource {
  CAMERA_ROLL
  LIVE_CAMERA
  LIBRARY
}

model JobPhoto {
  id         String @id @default(cuid())
  jobId      String
  companyId  String
  uploadedBy String

  publicId  String
  url       String
  secureUrl String
  format    String?
  bytes     Int?
  width     Int?
  height    Int?
  source    JobPhotoSource @default(LIBRARY)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job     Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([companyId])
  @@index([uploadedBy])
}

/// Clock in/out for a technician (user) within a company. Query by `companyId` and/or `userId`.
model TimeCard {
  id        String @id @default(cuid())
  userId    String
  companyId String

  clockedInAt  DateTime
  clockedOutAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, userId])
  @@index([companyId])
  @@index([userId])
}
