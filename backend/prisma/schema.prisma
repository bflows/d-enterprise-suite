generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String

  firstName   String
  lastName    String
  phoneNumber String
  profileImg  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshSessions RefreshSession[]
  employees       Employee[]
  timeCards       TimeCard[]
}

model RefreshSession {
  id               String @id @default(cuid())
  userId           String
  refreshTokenHash String

  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  userAgent String?
  ip        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Company {
  id       String @id @default(cuid())
  name     String
  industry String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles       Role[]
  employees   Employee[]
  customers   Customer[]
  serviceBook ServiceBook[]
  jobs        Job[]
  timeCards   TimeCard[]
}

model Role {
  id        String @id @default(cuid())
  name      String
  slug      String // permission names: employee, technician, dispatcher, admin
  companyId String

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@unique([companyId, slug])
}

model Employee {
  id        String @id @default(cuid())
  userId    String
  companyId String
  roleSlug  String

  user                     User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company                  Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role                     Role                     @relation(fields: [companyId, roleSlug], references: [companyId, slug], onDelete: Cascade)
  jobs                     Job[]
  technicianAvailabilities TechnicianAvailability[]

  @@index([userId, companyId])
  @@index([companyId])
}

/// Recurring weekly availability for a technician: one record = one day of week + time window.
/// Example: Employee has 3 records = Mon 9-5, Wed 9-12, Fri 9-5.
model TechnicianAvailability {
  id         String @id @default(cuid())
  employeeId String

  /// Day of week: 0 = Sunday, 1 = Monday, ... 6 = Saturday
  dayOfWeek        Int
  /// Start time in minutes from midnight (e.g. 540 = 09:00)
  startTimeMinutes Int
  /// End time in minutes from midnight (e.g. 1020 = 17:00)
  endTimeMinutes   Int

  /// Optional: rule only applies on or after this date
  effectiveFrom DateTime?
  /// Optional: rule only applies on or before this date
  effectiveTo   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model Customer {
  id          String  @id @default(cuid())
  companyId   String
  firstName   String
  lastName    String
  email       String?
  phone       String
  leadSource  String?
  address     String
  address2    String?
  companyName String?
  notes       String?

  company Company @relation(fields: [companyId], references: [id])
  jobs    Job[]

  @@index([companyId])
}

model ServiceBook {
  id        String  @id @default(uuid())
  companyId String
  name      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company               @relation(fields: [companyId], references: [id])
  catories ServiceBookCategory[]

  @@index([companyId])
}

model ServiceBookCategory {
  id            String @id @default(uuid())
  serviceBookId String
  name          String

  sortOrder Int?     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceBook ServiceBook   @relation(fields: [serviceBookId], references: [id], onDelete: Cascade)
  items       ServiceItem[]

  @@index([serviceBookId])
}

enum ServiceItemType {
  SERVICE
  ADDON
}

model ServiceItem {
  id         String          @id @default(uuid())
  categoryId String
  type       ServiceItemType

  title       String
  description String
  price       Int
  duration    Int
  unit        Int?
  quantity    Int @default(1)

  sortOrder Int?     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category ServiceBookCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  job      Job?                @relation(fields: [jobId], references: [id])
  jobId    String?

  @@index([categoryId])
}

enum JobStatusType {
  SCHEDULED
  EN_ROUTE
  ON_SITE
  COMPLETED
  INVOICED
  PAID
  CANCELLED
}

model Job {
  id           String @id @default(uuid())
  companyId    String
  customerId   String
  technicianId String

  title      String?
  notes      String?
  leadSource String?
  status     JobStatusType

  startDate DateTime
  endDate   DateTime
  startTime DateTime
  endTime   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company       @relation(fields: [companyId], references: [id])
  customer   Customer      @relation(fields: [customerId], references: [id])
  technician Employee      @relation(fields: [technicianId], references: [id])
  services   ServiceItem[]

  @@index([companyId])
  @@index([customerId])
  @@index([technicianId])
  @@index([startDate])
}

/// Clock in/out for a technician (user) within a company. Query by `companyId` and/or `userId`.
model TimeCard {
  id        String @id @default(cuid())
  userId    String
  companyId String

  clockedInAt  DateTime
  clockedOutAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, userId])
  @@index([companyId])
  @@index([userId])
}
